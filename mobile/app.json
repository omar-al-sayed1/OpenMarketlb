      "bundleIdentifier": "com.openmarket.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.openmarketlb.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCKzJi3012Oo3FTeo942eahUCjTo2mR-IA"
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "15478d41-d386-4f1a-b11e-9d055307cb5e"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
