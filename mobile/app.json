{
  "expo": {
    "name": "OpenMarket",
    "slug": "openmarket-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "openmarket",
    "icon": "./assets/icon.png",
